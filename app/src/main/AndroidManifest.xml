<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    >

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
<!--    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />-->

    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
        Разрешений на хранилище нет намеренно. Данные приложения лежат во
        внутренней памяти (filesDir/store) — туда доступ не выдаётся отдельно, и
        именно поэтому пароль на приложении закрывает сами файлы, а не только UI.
        Бэкап пишется через Storage Access Framework (пользователь выбирает файл
        в системном диалоге), «В галерею» — через MediaStore. Обоим разрешения
        не нужны.
    -->

    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />

    <!--
        Required for Nearby Connections.

        maxSdkVersion="32": начиная с Android 13 обнаружение устройств работает
        через NEARBY_WIFI_DEVICES, и геолокация Nearby больше не нужна. Раньше
        приложение просило точное местоположение на всех версиях — пользователь
        видел самый пугающий системный запрос там, где он не требуется.
        Набор runtime-разрешений задаётся в P2pPermissions и обязан совпадать
        с этим списком: разрешение, обрезанное здесь, на новых версиях уже не
        выдаётся, и запрашивать его бессмысленно.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="32" />

    <!-- Required for Nearby Connections on Android 12 and higher -->
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!--
        neverForLocation: сканирование используется только для поиска соседнего
        устройства, местоположение из результатов не выводится. Без флага система
        считает скан источником геоданных и тянет за собой запрос локации.
    -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="31" />
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="33" />

    <!--
        FOREGROUND_SERVICE, FOREGROUND_SERVICE_CONNECTED_DEVICE и POST_NOTIFICATIONS
        удалены отсюда: в коде приложения нет ни одного Service и ни одной
        нотификации. P2pReceiveManager работает, только пока приложение активно
        (см. его KDoc), фоновым сервисом он не является.

        FOREGROUND_SERVICE всё равно остаётся в merged manifest — его объявляет
        play-services-cast-framework для своих собственных сервисов; два других
        разрешения приходили только из этого файла и из APK ушли.

        Вернуть вместе с реальным ForegroundService, когда фоновый приём P2P
        будет реализован.
    -->









    <application
        android:name=".App"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:hapticFeedbackEnabled="true"
        android:icon="@drawable/logo"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@drawable/logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.Xvideos"
        tools:targetApi="33">
        <profileable
            android:shell="true"
            tools:targetApi="29" />

        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.MyApp.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Xvideos"
            android:windowBackground="@color/black"
            android:windowIsTranslucent="false"
            android:fitsSystemWindows="true"
            android:windowSoftInputMode="adjustResize">

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
