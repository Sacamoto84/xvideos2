<?xml version="1.0" encoding="utf-8"?>
<!--
  Области, из которых FileProvider вообще может отдать файл.

  Было `<files-path path="." />` и `<cache-path path="." />` — весь внутренний
  каталог приложения и весь кеш целиком. Права выдаются по конкретному URI, и
  единственный вызывающий (useCaseShareFile) передаёт конкретный файл, так что
  дыры это не давало. Но область была шире всего, чем приложение делится, а
  такие запасы держать незачем: их однажды используют по ошибке.

  Ниже — ровно то, откуда файлы уходят в «Поделиться» на сегодня.
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Файлы, скачанные для отправки из R: filesDir/store/R/Download.
         Было path="store/" — весь каталог данных приложения (история и загрузки X,
         коллекции L, сохранённое R), хотя отдаются только загрузки R (проход 207, A1). -->
    <files-path name="app_store" path="store/R/Download/" />

    <!-- Файлы, скачанные для отправки из L: cacheDir/L/Share -->
    <cache-path name="l_share_cache" path="L/Share/" />

</paths>
