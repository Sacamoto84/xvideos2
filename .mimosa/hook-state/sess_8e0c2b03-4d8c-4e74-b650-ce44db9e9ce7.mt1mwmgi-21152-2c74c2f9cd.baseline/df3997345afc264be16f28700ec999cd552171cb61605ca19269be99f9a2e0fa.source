// groovy-gradle-plugin компилирует каждый файл src/main/groovy/*.gradle в
// плагин, который подключается по имени файла: xvideos.android-library.gradle
// -> id 'xvideos.android-library'.
//
// Зависимости от AGP здесь нет намеренно. Плагин обращается к блоку `android`
// динамически, как это делает любой скрипт сборки на Groovy, и компилируется
// без классов AGP на пути. Тянуть сюда AGP значило бы фиксировать его версию
// в двух местах — в каталоге версий и здесь.
plugins {
    id 'groovy-gradle-plugin'
}
